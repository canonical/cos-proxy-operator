              "level": true,
              "msg": true,
              "output": true,
              "ts": false
            },
            "indexByName": {
              "command": 1,
              "command_output (lastNotNull)": 3,
              "juju_unit": 0,
              "return_code (lastNotNull)": 2,
              "ts (lastNotNull)": 4
            },
            "renameByName": {
              "command": "Command",
